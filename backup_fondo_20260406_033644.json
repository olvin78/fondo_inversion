border-box;\n    }\n</style>\n\n<div class=\"fc-page\">\n    <div class=\"fc-header-group\">\n        <div style=\"width: 65%;\">\n            <div class=\"fc-logo-txt\">FondoCapital</div>\n            <div class=\"fc-h1-small\">Informe mensual de</div>\n            <div class=\"fc-h1-brand\">\n                FondoCapital, <span class=\"fc-h1-name\">inaki</span>\n            </div>\n        </div>\n        <div class=\"fc-gestor-frame\">\n            <img src=\"/static/img/imagen_para_gestor_index.jpg\" alt=\"Gestor\" class=\"fc-gestor-img\">\n            <div\n                style=\"position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(11, 31, 58, 0.8); color: white; text-align: center; font-size: 7.5pt; font-weight: 700; padding: 1mm 0; z-index: 10;\">\n                GESTOR</div>\n        </div>\n    </div>\n\n    <hr class=\"fc-hr-sep\">\n\n    <div class=\"fc-main-text\">\n        <p><span class=\"fc-salutation\">Estimado/a inaki,</span></p>\n        <p>Mediante el presente documento, emitimos la certificación técnica mensual de su posición en FondoCapital.\n            Esta actualización refleja el estado consolidado de su capital y las participaciones asignadas bajo nuestra\n            gestión patrimonial privada al cierre de <strong>abril 2026</strong>.</p>\n    </div>\n\n    <table class=\"fc-mirror-table\">\n        <thead>\n            <tr>\n                <th>Segmento de Transacción</th>\n                <th>Datos Técnicos Consolidados</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td>Titular de la inversion:</td>\n                <td>inaki</td>\n            </tr>\n            <tr>\n                <td>Patrimonio Actual Neto:</td>\n                <td style=\"font-weight: 700;\">1933,0559 €</td>\n            </tr>\n            <tr>\n                <td>Capital Total Invertido:</td>\n                <td style=\"font-weight: 700;\">2040,9378 €</td>\n            </tr>\n            <tr>\n  