   page-break-inside: avoid;\n        }\n\n        .fc-header-group {\n            padding-top: 15mm !important;\n            margin-bottom: 2mm !important;\n        }\n\n        .fc-gestor-frame {\n            width: 38mm !important;\n            height: 48mm !important;\n        }\n\n        .fc-p-main {\n            margin-bottom: 3mm !important;\n        }\n\n        .fc-mirror-table {\n            margin-bottom: 3mm !important;\n            page-break-inside: avoid !important;\n        }\n\n        .fc-mirror-table td {\n            padding: 2mm 4mm !important;\n        }\n\n        .fc-footer-official {\n            /* Sincronizado con estilos generales */\n        }\n    }\n\n    /* TYPOGRAPHY */\n    .fc-logo-txt {\n        font-size: 18pt;\n        font-weight: 800;\n        color: #0b1f3a;\n        letter-spacing: -0.5px;\n        margin-bottom: 2mm;\n    }\n\n    .fc-header-group {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        padding-top: 12mm;\n        margin-bottom: 2mm;\n    }\n\n    .fc-h1-small {\n        font-size: 18pt;\n        font-weight: 400;\n        font-family: 'Georgia', serif;\n        color: #1e293b;\n        margin-bottom: 1mm;\n    }\n\n    .fc-h1-brand {\n        font-size: 22pt;\n        color: #0b1f3a;\n        font-family: 'Georgia', serif;\n    }\n\n    .fc-h1-name {\n        color: #a17c2f;\n    }\n\n    .fc-gestor-frame {\n        position: relative;\n        width: 38mm;\n        height: 48mm;\n        padding: 0;\n        background: white;\n        box-sizing: border-box;\n        box-shadow: 3mm 3mm 7mm rgba(11, 31, 58, 0.1);\n        overflow: hidden;\n    }\n\n    .fc-gestor-img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n        z-index: 2;\n        position: relative;\n    }\n\n    .fc-frame-bg {\n        position: absolute;\n        top: 3mm;\n        left: -3mm;\n        width: 100%;\n        height: 1